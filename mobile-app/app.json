{
  "expo": {
    "name": "Gisenyi Gadgets",
    "slug": "gisenyi-gadgets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "scheme": "com.gisenyigadgets.app",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.gisenyigadgets.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b0f6dd7c-493a-43bb-80f9-720966be95f4"
      }
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gisenyi Gadgets needs access to your photos to upload payment screenshots."
        }
      ],
      "expo-sharing"
    ]
  }
}
