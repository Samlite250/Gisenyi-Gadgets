{
  "buildCommand": "node scripts/build-all.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin/((?!.*\\.).*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}